{
  "openapi": "3.0.3",
  "info": {
    "title": "Creator Workbench Media Worker",
    "version": "1.0.0",
    "description": "工作台与远程媒体 Worker 的合同；不是 ComfyUI 原生协议。"
  },
  "servers": [
    {
      "url": "https://media-worker.example.invalid"
    }
  ],
  "security": [
    {
      "workerToken": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "执行端协议与能力",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "protocol",
                    "mediaKinds",
                    "supportsSeed"
                  ],
                  "properties": {
                    "protocol": {
                      "type": "string",
                      "enum": [
                        "creator-media-v1"
                      ]
                    },
                    "mediaKinds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "IMAGE",
                          "VIDEO"
                        ]
                      }
                    },
                    "supportsSeed": {
                      "type": "boolean"
                    },
                    "referenceRoles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "401": {
            "description": "认证失败"
          },
          "404": {
            "description": "任务不存在"
          },
          "409": {
            "description": "同ID不同内容冲突"
          },
          "503": {
            "description": "执行端不可用"
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "summary": "持久幂等受理一个候选生成任务",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResult"
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "401": {
            "description": "认证失败"
          },
          "404": {
            "description": "任务不存在"
          },
          "409": {
            "description": "同ID不同内容冲突"
          },
          "503": {
            "description": "执行端不可用"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobSpec"
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "summary": "查询原任务，不创建新生成",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResult"
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "401": {
            "description": "认证失败"
          },
          "404": {
            "description": "任务不存在"
          },
          "409": {
            "description": "同ID不同内容冲突"
          },
          "503": {
            "description": "执行端不可用"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            }
          }
        ]
      }
    },
    "/v1/jobs/{id}/cancel": {
      "post": {
        "summary": "幂等请求取消，只操作归属任务",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResult"
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "401": {
            "description": "认证失败"
          },
          "404": {
            "description": "任务不存在"
          },
          "409": {
            "description": "同ID不同内容冲突"
          },
          "503": {
            "description": "执行端不可用"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}/inputs/{inputId}": {
      "post": {
        "summary": "提交前上传参考图；相同ID相同内容幂等",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            }
          },
          {
            "in": "path",
            "name": "inputId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已保存"
          },
          "409": {
            "description": "原件内容冲突"
          }
        }
      }
    },
    "/v1/jobs/{id}/outputs/{outputId}": {
      "get": {
        "summary": "下载归属原件，最多50MB",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            }
          },
          {
            "in": "path",
            "name": "outputId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "原件",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "原件不存在"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "workerToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Reference": {
        "type": "object",
        "required": [
          "candidateId",
          "inputId",
          "sha256",
          "role"
        ],
        "properties": {
          "candidateId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "inputId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "GENERAL",
              "FIRST_FRAME",
              "LAST_FRAME",
              "CHARACTER",
              "STYLE"
            ]
          }
        }
      },
      "JobSpec": {
        "type": "object",
        "required": [
          "protocol",
          "id",
          "projectId",
          "productionNodeId",
          "mediaKind",
          "prompt",
          "parameters",
          "references",
          "maxCostCents",
          "need",
          "batch"
        ],
        "properties": {
          "protocol": {
            "type": "string",
            "enum": [
              "creator-media-v1"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "projectId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "productionNodeId": {
            "type": "string",
            "enum": [
              "N27",
              "N29"
            ]
          },
          "mediaKind": {
            "type": "string",
            "enum": [
              "IMAGE",
              "VIDEO"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          },
          "references": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/Reference"
            }
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "maxCostCents": {
            "type": "integer",
            "minimum": 0
          },
          "need": {
            "type": "object"
          },
          "batch": {
            "type": "object"
          }
        }
      },
      "Output": {
        "type": "object",
        "required": [
          "id",
          "fileName",
          "mediaType",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "fileName": {
            "type": "string"
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "video/mp4",
              "video/webm"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "JobResult": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "costCents": {
            "type": "integer",
            "minimum": 0
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/Output"
            }
          }
        }
      }
    }
  }
}
